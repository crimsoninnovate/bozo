# Root upload of the staged build to httpdocs. Only bozo-derleme.service's ExecStartPost= starts it.
[Unit]
Description=Ciğerci Bozo site upload

[Service]
Type=oneshot
Environment=PATH=/opt/plesk/node/24/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/bozo-derleme/yukle.sh
# Writes `hata` if the unit died past its trap.
ExecStopPost=/opt/bozo-derleme/yukle.sh
TimeoutStartSec=15min
NoNewPrivileges=yes
PrivateTmp=yes
