# Ciğerci Bozo, statik export. Sunucu davranışı burada, sürüm kontrolünde.
# Apache bu dosyayı doğrudan servis etmez; Plesk vhost'u .ht* erişimini kapatır.

# Tasarlanmış 404 sayfası. Plesk'in kendi error_docs'u yerine bu geçer.
ErrorDocument 404 /404.html

# llms.txt Türkçe karakterler taşır (ğ ı ç ö ü); Next route handler'ın Content-Type başlığı
# statik export'ta hiç gönderilmez (çalışma zamanı yok), o yüzden charset burada tanımlanır.
AddType 'text/plain; charset=utf-8' .txt

# Apache .webmanifest'i tanımıyor; manifest content-type'sız gidiyordu (8 Ekim 2026).
AddType application/manifest+json .webmanifest

# Güvenlik başlıkları, 8 Ekim 2026'ya kadar hiç gönderilmiyordu. HSTS includeSubDomains
# taşımaz: alt alan adlarının hepsinin HTTPS'e hazır olduğu doğrulanmadı.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # _next/static adları içerikten türer, değişen dosya yeni ad alır: bir yıl, değişmez.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>
